{
  "name": "rgaa-assist",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.16.1",
  "bin": {
    "rgaa-assist": "src/cli/main.ts"
  },
  "scripts": {
    "rgaa-assist": "node src/cli/main.ts",
    "evaluate": "node src/evaluation/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "axe-table": "node scripts/build-axe-table.ts",
    "packets": "node scripts/build-packets.ts",
    "validate-coverage": "node scripts/validate-coverage.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "axe-core": "4.14.0",
    "playwright": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
